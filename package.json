{
  "name": "the-local-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Local 3D - a train-journey portfolio. One dataset, three renderers.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run generate:content && npm run typecheck && vite build && npm run prerender && npm run inject:classic && node scripts/postbuild.mjs",
    "validate": "tsx scripts/validate-content.ts",
    "validate:strict": "tsx scripts/validate-content.ts --strict",
    "generate:content": "tsx scripts/build-content.ts",
    "prerender": "vite build --ssr scripts/prerender-classic.ts --outDir .prerender --emptyOutDir && node .prerender/prerender-classic.js",
    "inject:classic": "node scripts/inject-classic.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sitemap": "tsx scripts/build-sitemap.ts",
    "og": "tsx scripts/build-og.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
